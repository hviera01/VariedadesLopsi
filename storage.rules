rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Misma nota de seguridad que firestore.rules: esta app no usa Firebase
    // Authentication, así que request.auth siempre es null. Reglas
    // permisivas a propósito para que la app funcione.
    match /productos/{idArchivo} {
      allow read, write: if true;
    }
  }
}
